# Nginx 配置示例：托管前端静态文件并代理后端接口
# 用法：把本文件内容复制到 Nginx 的 conf/nginx.conf（或包含进 sites-enabled）

server {
    listen 80;
    server_name localhost;          # 改为你的域名或服务器 IP

    # 前端构建产物目录（npm run build 生成的 dist，按实际部署路径修改）
    root /usr/share/nginx/rental-platform/dist;
    index index.html;

    # Vue Router history 模式：刷新不 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口代理
    location /api/ {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 静态资源缓存
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
