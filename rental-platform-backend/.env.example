# 数据库连接
DB_USERNAME=replace_with_database_username
DB_PASSWORD=replace_with_database_password

# DeepSeek API
DEEPSEEK_API_KEY=replace_with_deepseek_api_key

# MinIO 客户端与本地服务端可共用这一组凭据
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key

# 至少使用32个字符的随机字符串
JWT_SECRET=replace_with_at_least_32_random_characters
